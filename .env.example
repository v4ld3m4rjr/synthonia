# ===== Supabase (login/cadastro + histórico) =====
# Crie um projeto em https://supabase.com e copie em Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# ===== Opcional: refinamento do texto do laudo via LLM =====
# Se preenchido, a IA generativa reescreve o resumo com base nas métricas.
# Deixe vazio para usar apenas o motor de análise local (funciona offline).
VITE_OPENAI_API_KEY=
